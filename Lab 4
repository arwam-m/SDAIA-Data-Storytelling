import plotly.graph_objects as go

fig = go.Figure()

fig.add_trace(go.Indicator(
   mode="number",
   value=8,
   number={"suffix": "%"},
   title={"text": "Overall Absence"}
))

fig.show()

import plotly.graph_objects as go

months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun"]
absence = [5, 6, 7, 8, 9, 8]

fig = go.Figure()

fig.add_trace(go.Scatter(
   x=months,
   y=absence,
   mode="lines+markers"
))

fig.update_layout(
   title="Monthly Absence Trend",
   xaxis_title="Month",
   yaxis_title="Absence (%)"
)

fig.show()

