def build_notes(storyboard_data, big_idea_text): # Add big_idea_text as an argument
   total = 0
   print(f"OPEN (say the ask): {big_idea_text}\n") # Use the argument
   for s in storyboard_data:
       secs = TIME_BOX.get(s[0].lower(), 45)
       total += secs
       print(f"[{total//60}:{total%60:02d}] {s[0]}")
       print(f"   Orient axes, then: {s[1]}")
       print("   Point at one mark; do NOT read it.")
   assert total <= 7*60, f"Over by {total-420}s — cut."
   print("CLOSE (ask AGAIN): approve; 90-day check.")

# Call build_notes with the explicitly defined storyboard and new_big_idea_text
build_notes(storyboard, new_big_idea_text)

